{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "A user profile containing basic info.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "region": {
          "type": "string",
          "description": "The user's home region."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "The user's role."
        },
        "chelseaPR": {
          "type": "number",
          "description": "The user's personal record for Chelsea (reps per minute)."
        },
        "photoURL": {
          "type": "string",
          "description": "The user's avatar image as a data URL or external URL."
        }
      },
      "required": ["name", "email", "role"]
    },
    "ChelseaWorkout": {
      "title": "ChelseaWorkout",
      "description": "A completed Chelsea workout record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "date": { "type": "string" },
        "totalTime": { "type": "number" },
        "totalRestTime": { "type": "number" },
        "totalRounds": { "type": "number" },
        "totalPullups": { "type": "number" },
        "totalPushups": { "type": "number" },
        "totalSquats": { "type": "number" },
        "repsPerMinute": { "type": "number" }
      },
      "required": ["userId", "userName", "date", "totalTime", "totalRestTime", "totalRounds", "totalPullups", "totalPushups", "totalSquats", "repsPerMinute"]
    },
    "Workout": {
      "title": "Workout",
      "description": "A saved F3 workout beatdown.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the workout."
        },
        "targetTime": {
          "type": "number",
          "description": "The target duration in minutes."
        },
        "sections": {
          "type": "array",
          "description": "The sections of the workout."
        },
        "date": {
          "type": "string",
          "description": "The date the workout was saved."
        },
        "authorUid": {
          "type": "string",
          "description": "The UID of the user who created the workout."
        }
      },
      "required": ["name", "targetTime", "sections", "date", "authorUid"]
    },
    "ExerciseNote": {
      "title": "ExerciseNote",
      "description": "Personal tips, modifications, and cues for a specific exercise.",
      "type": "object",
      "properties": {
        "exerciseName": {
          "type": "string",
          "description": "Name of the exercise."
        },
        "note": {
          "type": "string",
          "description": "User personal note or modification tips."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when note was last updated."
        }
      },
      "required": ["exerciseName", "note"]
    }
  },
  "firestore": {
    "/exerciseNotes/{noteId}": {
      "schema": {
        "$ref": "#/entities/ExerciseNote"
      },
      "description": "Stores cloud-persisted descriptions and notes for each exercise."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profiles."
    },
    "/users/{userId}/exerciseNotes/{noteId}": {
      "schema": {
        "$ref": "#/entities/ExerciseNote"
      },
      "description": "Stores user personal notes and modifications for specific exercises."
    },
    "/workouts/{workoutId}": {
      "schema": {
        "$ref": "#/entities/Workout"
      },
      "description": "Stores saved workouts."
    },
    "/chelseaWorkouts/{workoutId}": {
      "schema": {
        "$ref": "#/entities/ChelseaWorkout"
      },
      "description": "Stores completed Chelsea workouts."
    }
  }
}
